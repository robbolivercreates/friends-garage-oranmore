# Friends Garage — environment configuration
# Copy this file to ".env" (or ".env.local") and fill in real values.

# ------------------------------------------------------------------
# EMAIL (transactional notifications for bookings, estimates, etc.)
#
# If these are NOT set, the site still works fully — every email is
# written to data/outbox.json and logged in the server console instead.
#
# Easiest option — a Gmail account for the garage:
#   1. Enable 2-Step Verification on the Google account
#   2. Create an "App Password" at https://myaccount.google.com/apppasswords
#   3. Use smtp.gmail.com / 465 / the account email / the app password
# ------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""

# Sender shown to customers (defaults to the SMTP user)
MAIL_FROM="Friends Garage <info@friendsgarage.net>"

# Where NEW booking/estimate/callback/roadside alerts are sent
# (the garage's own inbox — can be any address staff actually read)
GARAGE_NOTIFY_EMAIL="info@friendsgarage.net"

# The URL where this app is hosted (used in emails / deployment)
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------
# ANALYTICS (optional) — Google Tag Manager container ID.
# Loaded only after the visitor accepts analytics/marketing cookies.
# Must be set at BUILD time (npm run build) — it's baked into the bundle.
# Facebook/Meta Pixel: add it inside the GTM container, no code needed.
# ------------------------------------------------------------------
VITE_GTM_ID=""
